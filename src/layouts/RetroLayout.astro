---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	article?: boolean;
	publishedDate?: Date;
	modifiedDate?: Date;
	tags?: string[];
}

const { title, description, image, article, publishedDate, modifiedDate, tags } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} article={article} publishedDate={publishedDate} modifiedDate={modifiedDate} tags={tags} />
	</head>
	<body>
		<div id="reading-progress-bar" class="reading-progress-bar" aria-hidden="true"></div>
		<div class="retro-container" id="top">
			<Header />
			
			<table class="layout-table" width="100%" border="0" cellspacing="8" cellpadding="0" role="presentation">
				<tr>
					<td class="sidebar-cell" style="width: 250px;" valign="top">
						<Sidebar />
					</td>
					<td class="content-cell" valign="top">
						<main class="main-content-pane">
							<slot />
						</main>
					</td>
				</tr>
			</table>

			<Footer />
		</div>

		<script>
			// Web Audio API Synthesizer with User Gesture Unlock
			let blogAudioCtx = null;
			let isAudioMuted = localStorage.getItem('blog_sfx_muted') === 'true';

			function updateSfxButtonState() {
				const btn = document.getElementById('sfx-toggle-btn');
				if (btn) {
					btn.textContent = isAudioMuted ? '[ 🔇 SFX MUTE ]' : '[ 🔊 SFX ON ]';
					if (isAudioMuted) {
						btn.classList.add('muted');
					} else {
						btn.classList.remove('muted');
					}
				}
			}

			function initAudioContext() {
				if (!blogAudioCtx && typeof window !== 'undefined') {
					const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
					if (AudioContextClass) {
						blogAudioCtx = new AudioContextClass();
					}
				}
				if (blogAudioCtx && blogAudioCtx.state === 'suspended') {
					blogAudioCtx.resume();
				}
				return blogAudioCtx;
			}

			// Unlock audio context on any user interaction
			const unlockAudio = () => {
				initAudioContext();
				window.removeEventListener('pointerdown', unlockAudio);
				window.removeEventListener('click', unlockAudio);
				window.removeEventListener('keydown', unlockAudio);
			};
			window.addEventListener('pointerdown', unlockAudio);
			window.addEventListener('click', unlockAudio);
			window.addEventListener('keydown', unlockAudio);

			function playBlogSound(type = 'click') {
				if (isAudioMuted) return;
				const ctx = initAudioContext();
				if (!ctx) return;
				const now = ctx.currentTime;

				try {
					switch (type) {
						case 'click': {
							const osc1 = ctx.createOscillator();
							const gain1 = ctx.createGain();
							osc1.type = 'sine';
							osc1.frequency.setValueAtTime(1400, now);
							osc1.frequency.exponentialRampToValueAtTime(120, now + 0.035);
							gain1.gain.setValueAtTime(0.08, now);
							gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.035);
							osc1.connect(gain1);
							gain1.connect(ctx.destination);
							osc1.start(now);
							osc1.stop(now + 0.04);
							break;
						}
						case 'hover': {
							const osc = ctx.createOscillator();
							const gain = ctx.createGain();
							osc.type = 'sine';
							osc.frequency.setValueAtTime(950, now);
							gain.gain.setValueAtTime(0.012, now);
							gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.018);
							osc.connect(gain);
							gain.connect(ctx.destination);
							osc.start(now);
							osc.stop(now + 0.018);
							break;
						}
						case 'copy': {
							const osc = ctx.createOscillator();
							const gain = ctx.createGain();
							osc.type = 'sine';
							osc.frequency.setValueAtTime(880, now);
							osc.frequency.exponentialRampToValueAtTime(1760, now + 0.07);
							gain.gain.setValueAtTime(0.08, now);
							gain.gain.exponentialRampToValueAtTime(0.001, now + 0.07);
							osc.connect(gain);
							gain.connect(ctx.destination);
							osc.start(now);
							osc.stop(now + 0.07);
							break;
						}
						case 'toggle': {
							const osc = ctx.createOscillator();
							const gain = ctx.createGain();
							osc.type = 'triangle';
							osc.frequency.setValueAtTime(500, now);
							osc.frequency.exponentialRampToValueAtTime(1000, now + 0.06);
							gain.gain.setValueAtTime(0.06, now);
							gain.gain.linearRampToValueAtTime(0.001, now + 0.06);
							osc.connect(gain);
							gain.connect(ctx.destination);
							osc.start(now);
							osc.stop(now + 0.06);
							break;
						}
					}
				} catch (e) {}
			}

			// Add global click sound listener
			document.addEventListener('click', (event) => {
				const target = event.target as HTMLElement | null;
				if (!target) return;

				const sfxBtn = target.closest('#sfx-toggle-btn');
				if (sfxBtn) {
					isAudioMuted = !isAudioMuted;
					localStorage.setItem('blog_sfx_muted', isAudioMuted ? 'true' : 'false');
					updateSfxButtonState();
					if (!isAudioMuted) playBlogSound('toggle');
					return;
				}

				const clickable = target.closest('a, button, input[type="submit"], input[type="button"], .control-btn, .control-btn-winamp, tr.post-wrapper-tr, .icon-post-card, .tool-btn');
				if (clickable) {
					playBlogSound('click');
				}
			});

			// Add hover sound listener
			let lastHoverTime = 0;
			document.addEventListener('mouseover', (event) => {
				const target = event.target as HTMLElement | null;
				if (!target) return;
				const now = Date.now();
				if (now - lastHoverTime < 100) return;

				const hoverable = target.closest('.icon-post-card, .post-wrapper-tr, nav.header-menu a, .tool-btn, .sfx-toggle-btn');
				if (hoverable) {
					lastHoverTime = now;
					playBlogSound('hover');
				}
			});

			// Reading Progress Bar Script
			window.addEventListener('scroll', () => {
				const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
				const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
				const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
				const progressBar = document.getElementById('reading-progress-bar');
				if (progressBar) {
					progressBar.style.width = scrolled + '%';
				}
			});

			// Inject "Copy Code" button into code blocks & initialize SFX button
			document.addEventListener('DOMContentLoaded', () => {
				updateSfxButtonState();
				const preBlocks = document.querySelectorAll('pre');
				preBlocks.forEach((pre) => {
					if (pre.querySelector('.copy-code-btn')) return;
					pre.style.position = 'relative';

					const btn = document.createElement('button');
					btn.className = 'copy-code-btn';
					btn.textContent = '[ Copy Code ]';
					btn.type = 'button';
					btn.style.position = 'absolute';
					btn.style.top = '6px';
					btn.style.right = '6px';
					btn.style.fontSize = '10px';
					btn.style.padding = '2px 6px';
					btn.style.cursor = 'pointer';
					btn.style.zIndex = '10';

					btn.addEventListener('click', (e) => {
						e.stopPropagation();
						const code = pre.querySelector('code');
						const text = code ? code.innerText : pre.innerText;
						navigator.clipboard.writeText(text).then(() => {
							playBlogSound('copy');
							btn.textContent = '[ Copied! ]';
							setTimeout(() => {
								btn.textContent = '[ Copy Code ]';
							}, 2000);
						});
					});

					pre.appendChild(btn);
				});
			});

		</script>
	</body>
</html>

<style lang="scss">
	@use "../styles/variables" as *;

	.layout-table {
		margin-top: 10px;
		margin-bottom: 10px;
	}

	.sidebar-cell {
		width: 250px;
		padding: 0;
	}

	.content-cell {
		padding: 0;
	}

	.main-content-pane {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	@media (max-width: 768px) {
		.layout-table {
			display: block;
			margin-top: 5px;
			margin-bottom: 5px;
			border-spacing: 0;
		}

		.layout-table > tbody,
		.layout-table > tbody > tr,
		.sidebar-cell,
		.content-cell {
			display: block;
			width: 100% !important;
		}

		.sidebar-cell {
			margin-bottom: 15px;
		}
	}
</style>
