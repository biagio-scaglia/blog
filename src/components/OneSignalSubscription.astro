---
import { ONESIGNAL_APP_ID } from '../consts';
import GlobeIcon from './icons/GlobeIcon.astro';
---

<div class="onesignal-widget">
	<div class="connection-status-panel">
		<div class="status-header">
			<GlobeIcon size={12} class="globe-status-icon" />
			<span class="status-lbl">Desktop Alerts Settings</span>
		</div>
		<div class="status-body">
			<p class="status-desc">
				Receive a real-time pop-up alert on your desktop or phone when Biagio publishes a new entry.
			</p>
			<div class="status-state-box">
				<span class="state-label">Connection:</span>
				<span id="onesignal-status-text" class="state-value loading">Initializing...</span>
			</div>
			<div class="actions-row">
				<button id="onesignal-subscribe-btn" class="retro-subscribe-btn" disabled>
					Connecting...
				</button>
			</div>
		</div>
	</div>
</div>

<script is:inline define:vars={{ appId: ONESIGNAL_APP_ID }}>
	// Asynchronously load the OneSignal SDK client-side library if App ID is configured
	if (appId) {
		const script = document.createElement('script');
		script.src = "https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js";
		script.defer = true;
		document.head.appendChild(script);

		window.OneSignalDeferred = window.OneSignalDeferred || [];
		window.OneSignalDeferred.push(async function(OneSignal) {
			await OneSignal.init({
				appId: appId,
				allowLocalhostAsSecureOrigin: true, // Enable for local testing
				notifyButton: {
					enable: false, // We build our own retro custom sidebar UI
				},
			});
		});
	}
</script>

<script>
	import { ONESIGNAL_APP_ID } from '../consts';

	document.addEventListener('DOMContentLoaded', () => {
		const statusText = document.getElementById('onesignal-status-text');
		const subscribeBtn = document.getElementById('onesignal-subscribe-btn') as HTMLButtonElement | null;

		if (!ONESIGNAL_APP_ID) {
			console.warn("[OneSignal Alerts] App ID is not configured in consts.ts");
			if (statusText && subscribeBtn) {
				statusText.textContent = "Offline (No App ID)";
				statusText.className = "state-value error";
				subscribeBtn.textContent = "No App ID Configured";
				subscribeBtn.disabled = true;
			}
			return;
		}

		if (!statusText || !subscribeBtn) return;

		const statusTextEl = statusText as HTMLElement;
		const subscribeBtnEl = subscribeBtn as HTMLButtonElement;

		console.log("[OneSignal Alerts] Widget scripts loaded. Queuing setup handler...");

		// Safely queue setup via deferred load array to execute after init completion
		const OSDeferred = (window as any).OneSignalDeferred = (window as any).OneSignalDeferred || [];
		OSDeferred.push(async function(OS: any) {
			console.log("[OneSignal Alerts] SDK successfully initialized. Binding widget controls...");

			function updateUI() {
				try {
					const isOptedIn = OS.User?.PushSubscription?.optedIn;
					const permission = Notification.permission;
					console.log("[OneSignal Alerts] State update - Permission:", permission, "OptedIn:", isOptedIn);

					if (permission === 'denied') {
						statusTextEl.textContent = "Blocked by Browser";
						statusTextEl.className = "state-value error";
						subscribeBtnEl.textContent = "Alerts Blocked";
						subscribeBtnEl.disabled = true;
					} else if (isOptedIn) {
						statusTextEl.textContent = "Connected ✓";
						statusTextEl.className = "state-value active";
						subscribeBtnEl.textContent = "Disable Alerts";
						subscribeBtnEl.disabled = false;
					} else {
						statusTextEl.textContent = "Disconnected";
						statusTextEl.className = "state-value inactive";
						subscribeBtnEl.textContent = "Enable Alerts";
						subscribeBtnEl.disabled = false;
					}
				} catch (e) {
					console.error("[OneSignal Alerts] UI status check failed:", e);
					statusTextEl.textContent = "Unsupported";
					statusTextEl.className = "state-value error";
					subscribeBtnEl.textContent = "Not Supported";
					subscribeBtnEl.disabled = true;
				}
			}

			// Validate standard browser notification support
			if (!('Notification' in window)) {
				console.warn("[OneSignal Alerts] Native Notification API is missing in this browser");
				statusTextEl.textContent = "Unsupported";
				statusTextEl.className = "state-value error";
				subscribeBtnEl.textContent = "Not Supported";
				subscribeBtnEl.disabled = true;
				return;
			}

			// Initial UI state render
			updateUI();

			// Event handler for permission & subscription changes
			if (OS.Notifications) {
				OS.Notifications.addEventListener("permissionChange", () => {
					console.log("[OneSignal Alerts] Native permission state change triggered");
					updateUI();
				});
			}
			if (OS.User?.PushSubscription) {
				OS.User.PushSubscription.addEventListener("change", () => {
					console.log("[OneSignal Alerts] PushSubscription state change triggered");
					updateUI();
				});
			}

			// Prevent binding multiple click handlers
			if (subscribeBtnEl.dataset.bound) return;
			subscribeBtnEl.dataset.bound = "true";

			// Attach toggle click handler
			subscribeBtnEl.addEventListener('click', async () => {
				console.log("[OneSignal Alerts] Button clicked. OptedIn:", OS.User?.PushSubscription?.optedIn);
				try {
					const isOptedIn = OS.User?.PushSubscription?.optedIn;
					if (isOptedIn) {
						console.log("[OneSignal Alerts] Opting out of push subscriptions...");
						await OS.User?.PushSubscription?.optOut();
						console.log("[OneSignal Alerts] Opt-out complete");
						updateUI();
					} else {
						console.log("[OneSignal Alerts] Opting into push subscriptions...");
						subscribeBtnEl.disabled = true;
						subscribeBtnEl.textContent = "Requesting...";
						await OS.User?.PushSubscription?.optIn();
						console.log("[OneSignal Alerts] Opt-in complete");
						updateUI();
					}
				} catch (e) {
					console.error("[OneSignal Alerts] Registration action encountered an error:", e);
					updateUI();
				}
			});
		});
	});
</script>

<style lang="scss">
	@use "../styles/variables" as *;

	.onesignal-widget {
		width: 100%;
		font-family: $font-verdana;
		font-size: 11px;
	}

	.connection-status-panel {
		background: #ffffff;
		@include win95-border-inset;
		padding: 6px;
	}

	.status-header {
		background: $win-blue;
		color: $win-white;
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 3px 6px;
		font-family: $font-tahoma;
		font-weight: bold;
		font-size: 10px;
		margin-bottom: 8px;
	}

	.globe-status-icon {
		filter: brightness(0) invert(1);
	}

	.status-desc {
		color: #333333;
		margin: 0 0 8px 0;
		line-height: 1.3;
	}

	.status-state-box {
		display: flex;
		justify-content: space-between;
		align-items: center;
		background: $win-light-gray;
		border: 1px solid $win-dark-gray;
		padding: 4px 8px;
		font-family: $font-retro-mono;
		font-size: 10px;
		font-weight: bold;
		margin-bottom: 8px;
	}

	.state-label {
		color: $win-dark-gray;
	}

	.state-value {
		padding: 1px 4px;
		border-radius: 1px;

		&.loading {
			color: #555555;
		}

		&.active {
			background: #e2f0cb;
			color: #388e3c;
			outline: 1px solid #388e3c;
		}

		&.inactive {
			color: $win-dark-gray;
		}

		&.error {
			background: #fdd8d8;
			color: #d32f2f;
			outline: 1px dashed #d32f2f;
		}
	}

	.actions-row {
		display: flex;
		justify-content: center;
	}

	.retro-subscribe-btn {
		@include win95-border-outset;
		background: $win-gray;
		color: $win-text;
		font-family: $font-verdana;
		font-size: 11px;
		font-weight: bold;
		padding: 4px 12px;
		cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'><path d='M10 2l3 0 0 12 3 0 0-7 2 0 0 7 1 0 0-6 2 0 0 6 1 0 0-5 2 0 0 9-1 0 0 2-1 0 0 1-1 0 0 1-7 0 0-1-3 0 0-1-1 0 0-5-2 0 0-3 2 0 0-3z' fill='white' stroke='black' stroke-width='1.5' stroke-linejoin='round'/></svg>") 10 2, pointer;
		outline: none;
		border-radius: 0;
		width: 100%;
		text-align: center;
		user-select: none;

		&:active:not(:disabled) {
			border-color: $win-dark-gray $win-white $win-white $win-dark-gray;
			padding: 5px 11px 3px 13px;
		}

		&:disabled {
			color: $win-dark-gray;
			cursor: default;
		}
	}
</style>
